{
  "screen": {
    "geometry_source": "qscreen",
    "corner_failsafe_ms": 500,
    "corner_region_px": 20
  },
  "hotkeys": {
    "toggle_tracking": "<esc>"
  },
  "active_provider": "openseeface",
  "ui": {
    "recording_enabled": false,
    "mouse_control_enabled": true,
    "calibration_enabled": false,
    "dwell_click": {
      "enabled": true,
      "dwell_time_s": 1.8,
      "movement_tolerance_px": 32.0,
      "resume_time_s": 0.3,
      "ring_color": "#0055ff",
      "ring_diameter_px": 31,
      "ring_thickness_px": 6,
      "zoom_enabled": true,
      "zoom_height_px": 200,
      "zoom_scale": 4.0,
      "zoom_width_px": 300
    }
  },
  "calibration": {
    "read_duration_s": 5.0,
    "capture_duration_s": 5.0
  },
  "providers": {
    "uniface": {
      "camera_index": 0,
      "target_fps": 30,
      "landmarker_model_path": "models/face_landmarker.task",
      "tracking_lost_hold_ms": 500
    },
    "openseeface": {
      "source": "camera",
      "camera_index": 0,
      "target_fps": 30,
      "frame_width": 640,
      "frame_height": 480,
      "model": 3,
      "model_dir": "models/openseeface",
      "detection_threshold": 0.6,
      "landmark_threshold": 0.6,
      "threads": 2,
      "udp_host": "127.0.0.1",
      "udp_port": 11573,
      "face_id": 0,
      "tracking_lost_hold_ms": 500
    },
    "ximu3": {
      "connection_type": "wifi_ap",
      "port_name": "",
      "wifi_ip_address": "192.168.1.1",
      "wifi_port_send": 9000,
      "wifi_port_receive": 8001,
      "axes_alignment": "+Y-Z-X",
      "ahrs_axes_convention": 2,
      "ahrs_ignore_magnetometer": true,
      "target_rate_hz": 200
    },
    "airpods": {
      "udp_host": "127.0.0.1",
      "udp_port": 5005
    }
  },
  "mouse_profiles": {
    "uniface": {
      "mode": "velocity",
      "absolute": {
        "kx": 90.0,
        "ky": 90.0
      },
      "velocity": {
        "kx": 50,
        "ky": 50,
        "gamma": 1.1,
        "deadband_deg_s": 0.15
      },
      "one_euro_filter": {
        "enabled": true,
        "min_cutoff": 2.0,
        "beta": 0.5,
        "d_cutoff": 1.0
      },
      "auto_zero": {
        "enabled": false,
        "stationary_window_ms": 200,
        "stationary_threshold_deg_s": 2.0
      },
      "yaw_drift_correction": {
        "enabled": false,
        "time_constant_s": 20.0
      }
    },
    "openseeface": {
      "mode": "velocity",
      "absolute": {
        "kx": 90.0,
        "ky": 90.0
      },
      "velocity": {
        "kx": 50,
        "ky": 50,
        "gamma": 1.1,
        "deadband_deg_s": 0.15
      },
      "one_euro_filter": {
        "enabled": true,
        "min_cutoff": 2.0,
        "beta": 0.5,
        "d_cutoff": 1.0
      },
      "auto_zero": {
        "enabled": false,
        "stationary_window_ms": 200,
        "stationary_threshold_deg_s": 2.0
      },
      "yaw_drift_correction": {
        "enabled": false,
        "time_constant_s": 20.0
      }
    },
    "ximu3": {
      "mode": "velocity",
      "absolute": {
        "kx": 90.0,
        "ky": 90.0
      },
      "velocity": {
        "kx": 40,
        "ky": 40,
        "gamma": 1.2,
        "deadband_deg_s": 0.0
      },
      "one_euro_filter": {
        "enabled": true,
        "min_cutoff": 2.0,
        "beta": 0.5,
        "d_cutoff": 1.0
      },
      "auto_zero": {
        "enabled": false,
        "stationary_window_ms": 200,
        "stationary_threshold_deg_s": 2.0
      },
      "yaw_drift_correction": {
        "enabled": false,
        "time_constant_s": 20.0
      }
    },
    "airpods": {
      "mode": "velocity",
      "absolute": {
        "kx": 90.0,
        "ky": 90.0
      },
      "velocity": {
        "kx": 50,
        "ky": 50,
        "gamma": 1.2,
        "deadband_deg_s": 0.0
      },
      "one_euro_filter": {
        "enabled": true,
        "min_cutoff": 2.0,
        "beta": 0.5,
        "d_cutoff": 1.0
      },
      "auto_zero": {
        "enabled": false,
        "stationary_window_ms": 200,
        "stationary_threshold_deg_s": 2.0
      },
      "yaw_drift_correction": {
        "enabled": false,
        "time_constant_s": 20.0
      }
    }
  },
  "recorder": {
    "base_dir": null,
    "output_dir": "sessions/",
    "format": "json"
  }
}
