{
  "screen": {
    "geometry_source": "qscreen",
    "corner_failsafe_ms": 500,
    "corner_region_px": 20
  },
  "hotkeys": {
    "toggle_tracking": "<esc>"
  },
  "active_provider": "ximu3",
  "ui": {
    "recording_enabled": true,
    "mouse_control_enabled": true,
    "calibration_enabled": true
  },
  "calibration": {
    "read_duration_s": 5.0,
    "capture_duration_s": 5.0
  },
  "providers": {
    "uniface": {
      "camera_index": 0,
      "target_fps": 30,
      "landmarker_model_path": "models/face_landmarker.task",
      "tracking_lost_hold_ms": 500
    },
    "ximu3": {
      "connection_type": "wifi_ap",
      "port_name": "",
      "wifi_ip_address": "192.168.1.1",
      "wifi_port_send": 9000,
      "wifi_port_receive": 8001,
      "axes_alignment": "-Y+Z-X",
      "ahrs_axes_convention": 2,
      "ahrs_ignore_magnetometer": true,
      "target_rate_hz": 200
    },
    "airpods": {
      "udp_host": "127.0.0.1",
      "udp_port": 5005
    }
  },
  "dsp": {
    "mode": "velocity",
    "absolute": {
      "kx": 75.0,
      "ky": 60.0
    },
    "velocity": {
      "kx": 85,
      "ky": 77,
      "gamma": 1.2,
      "deadband_deg_s": 0.0
    },
    "one_euro_filter": {
      "enabled": true,
      "min_cutoff": 2.0,
      "beta": 0.5,
      "d_cutoff": 1.0
    },
    "auto_zero": {
      "enabled": false,
      "stationary_window_ms": 200,
      "stationary_threshold_deg_s": 2.0
    },
    "yaw_drift_correction": {
      "enabled": false,
      "time_constant_s": 20.0
    }
  },
  "recorder": {
    "output_dir": "sessions/",
    "format": "json"
  }
}
